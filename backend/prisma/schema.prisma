generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Role {
  PATIENT
  DOCTOR
  NURSE
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum TestStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model User {
  id           Int        @id @default(autoincrement()) @map("user_id")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  email        String     @unique
  phone        String?
  passwordHash String     @map("password_hash")
  gender       Gender?
  dateOfBirth  DateTime?  @map("date_of_birth") @db.Date
  address      String?
  role         Role       @default(PATIENT)
  createdAt    DateTime   @default(now()) @map("created_at")
  status       UserStatus @default(ACTIVE)

  doctor         Doctor?
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  feedbacks      Feedback[]
  notifications  Notification[]

  @@map("users")
}

model Department {
  id             Int     @id @default(autoincrement()) @map("department_id")
  departmentName String  @map("department_name")
  description    String?
  location       String?

  doctors Doctor[]

  @@map("departments")
}

// staffId совпадает с user_id пользователя с ролью DOCTOR
model Doctor {
  staffId        Int       @id @map("staff_id")
  departmentId   Int?      @map("department_id")
  hireDate       DateTime? @map("hire_date") @db.Date
  licenseNumber  String?   @map("license_number")
  specialization String?

  user         User          @relation(fields: [staffId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  schedules    Schedule[]
  appointments Appointment[]
  feedbacks    Feedback[]

  @@map("doctors")
}

model Schedule {
  id        Int      @id @default(autoincrement()) @map("schedule_id")
  doctorId  Int      @map("doctor_id")
  workDate  DateTime @map("work_date") @db.Date
  startTime DateTime @map("start_time") @db.Time
  endTime   DateTime @map("end_time") @db.Time

  doctor Doctor @relation(fields: [doctorId], references: [staffId])

  @@map("schedules")
}

model Appointment {
  id              Int               @id @default(autoincrement()) @map("appointment_id")
  patientId       Int               @map("patient_id")
  doctorId        Int               @map("doctor_id")
  appointmentDate DateTime          @map("appointment_date")
  status          AppointmentStatus @default(PENDING)
  reason          String?
  notes           String?

  patient       User           @relation(fields: [patientId], references: [id])
  doctor        Doctor         @relation(fields: [doctorId], references: [staffId])
  medicalRecord MedicalRecord?
  notifications Notification[]

  @@map("appointments")
}

model Diagnosis {
  id          Int     @id @default(autoincrement()) @map("diagnosis_id")
  name        String
  description String?

  medicalRecords MedicalRecord[]

  @@map("diagnosis")
}

model MedicalRecord {
  id            Int      @id @default(autoincrement()) @map("record_id")
  patientId     Int      @map("patient_id")
  appointmentId Int?     @unique @map("appointment_id")
  diagnosisId   Int?     @map("diagnosis_id")
  treatment     String?
  prescription  String?
  createdAt     DateTime @default(now()) @map("created_at")

  patient       User           @relation(fields: [patientId], references: [id])
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  diagnosis     Diagnosis?     @relation(fields: [diagnosisId], references: [id])
  testResults   TestResult[]
  prescriptions Prescription[]

  @@map("medical_records")
}

model TestResult {
  id            Int        @id @default(autoincrement()) @map("test_id")
  recordId      Int        @map("record_id")
  testName      String     @map("test_name")
  resultDetails String?    @map("result_details")
  testDate      DateTime   @map("test_date")
  status        TestStatus @default(PENDING)

  record MedicalRecord @relation(fields: [recordId], references: [id])

  @@map("test_results")
}

model Prescription {
  id             Int     @id @default(autoincrement()) @map("prescription_id")
  recordId       Int     @map("record_id")
  medicationName String  @map("medication_name")
  dosage         String?
  frequency      String?
  duration       String?

  record MedicalRecord @relation(fields: [recordId], references: [id])

  @@map("prescriptions")
}

model Feedback {
  id        Int      @id @default(autoincrement()) @map("feedback_id")
  patientId Int      @map("patient_id")
  doctorId  Int      @map("doctor_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  patient User   @relation(fields: [patientId], references: [id])
  doctor  Doctor @relation(fields: [doctorId], references: [staffId])

  @@map("feedbacks")
}

model Notification {
  id            Int      @id @default(autoincrement()) @map("notification_id")
  userId        Int      @map("user_id")
  appointmentId Int?     @map("appointment_id")
  title         String
  message       String?
  isRead        Boolean  @default(false) @map("is_read")
  createdAt     DateTime @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@map("notifications")
}
